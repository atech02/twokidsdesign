# ==============================================================================
# TWO KIDS DESIGN — SECURE SERVER ENVIRONMENT CONFIGURATION
# ==============================================================================
# Copy this file to .env.local for local development. Never commit .env or .env.local to Git!

# ------------------------------------------------------------------------------
# LIPILA PAYMENT GATEWAY CONFIGURATION
# ------------------------------------------------------------------------------
# Environment selector: 'production' or 'sandbox'
LIPILA_ENV=production

# Production Base URL: https://blz.lipila.io
# Sandbox Base URL: https://api.lipila.dev
LIPILA_BASE_URL=https://blz.lipila.io

# Server-Side Secret API Key (Keep secure on server; NEVER expose to client)
lipila_secret_api=your_lipila_secret_api_key_here

# Public HTTPS Callback Webhook URL registered for collection callbacks
# Set to your actual deployed domain, e.g. https://twokidsdesign.web.app/api/webhooks/lipila
LIPILA_CALLBACK_URL=https://twokidsdesign.web.app/api/webhooks/lipila

# ------------------------------------------------------------------------------
# DIGITAL DOWNLOAD SECURITY & TOKENS
# ------------------------------------------------------------------------------
# Secret key used for signing HMAC-SHA256 24-hour PDF download tokens
DOWNLOAD_TOKEN_SECRET=generate_a_random_32_byte_secret_for_production

# ------------------------------------------------------------------------------
# RESEND TRANSACTIONAL EMAIL NOTIFICATION SERVICE
# ------------------------------------------------------------------------------
# Get your API key from https://resend.com/api-keys
# Server-side only: NEVER expose RESEND_API_KEY to browser JavaScript or client code
RESEND_API_KEY=re_123456789_abcdefghijklmnopqrstuvwxyz

# Verified sending domain sender (e.g. orders@twokidsdesign.com or Resend test onboarding@resend.dev)
ORDER_EMAIL_FROM=Two Kids Design <orders@twokidsdesign.com>

# Store identity and support variables
STORE_NAME=Two Kids Design
STORE_URL=https://twokidsdesign.web.app
SUPPORT_EMAIL=support@twokidsdesign.com

