# ==============================================================================
# TWO KIDS DESIGN — SERVER & CLIENT ENVIRONMENT CONFIGURATION
# ==============================================================================
# Set these environment variables in your Netlify Site Settings:
# Netlify Dashboard -> Site configuration -> Environment variables

# ------------------------------------------------------------------------------
# 1. FRONTEND CONFIGURATION (Built into Firebase Hosting bundle)
# ------------------------------------------------------------------------------
# Set this to your deployed Netlify backend domain (e.g., https://twokidsdesign-api.netlify.app)
# Leave empty for local development when running with the integrated dev server.
VITE_API_URL=https://your-backend-subdomain.netlify.app

# ------------------------------------------------------------------------------
# 2. LIPILA PAYMENT GATEWAY CONFIGURATION (Netlify Server-Side Only)
# ------------------------------------------------------------------------------
# Environment mode: 'production' or 'sandbox'
LIPILA_ENV=production

# Production Base URL: https://blz.lipila.io
# Sandbox Base URL: https://api.lipila.dev
LIPILA_BASE_URL=https://blz.lipila.io

# Server-Side Secret API Key (Keep secure on Netlify; NEVER expose to client)
lipila_secret_api=your_lipila_secret_api_key_here

# Public HTTPS Callback Webhook URL registered with Lipila for payment callbacks
# Point this to your Netlify backend webhook endpoint:
LIPILA_CALLBACK_URL=https://your-backend-subdomain.netlify.app/api/webhooks/lipila

# ------------------------------------------------------------------------------
# 3. DIGITAL DOWNLOAD SECURITY & TOKENS (Netlify Server-Side Only)
# ------------------------------------------------------------------------------
# Secret key used for signing HMAC-SHA256 24-hour PDF download tokens
# Use any random string or generate one via: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
DOWNLOAD_TOKEN_SECRET=your_secret_signing_key_here

# ------------------------------------------------------------------------------
# 4. RESEND TRANSACTIONAL EMAIL SERVICE (Netlify Server-Side Only)
# ------------------------------------------------------------------------------
# Get your API key from https://resend.com/api-keys
# Server-side only: NEVER expose RESEND_API_KEY to browser JavaScript
RESEND_API_KEY=re_your_resend_api_key_here

# Verified sending domain sender (e.g. Two Kids Design <orders@twokidsdesign.com>)
ORDER_EMAIL_FROM=Two Kids Design <orders@twokidsdesign.com>

# Store identity and support variables
STORE_NAME=Two Kids Design
STORE_URL=https://twokidsdesign.web.app
SUPPORT_EMAIL=support@twokidsdesign.com
